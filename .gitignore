# ======================================
# 2. 机器学习/LLM 项目核心忽略项（重点！）
# ======================================
# 你的 artifacts 目录（模型、数据、日志全在这，体积极大，必须忽略）
artifacts/
datasets/

# 模型权重/检查点文件（防止大文件提交）
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.gguf
*.onnx
*.pkl
*.pickle

# 训练数据/中间文件
*.h5
*.npy
*.npz
*.csv
*.jsonl
*.txt.tmp

# 训练日志/可视化文件
logs/
runs/
tensorboard/
wandb/

# ======================================
# 3. IDE/编辑器配置文件
# ======================================
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp

# ======================================
# 4. 系统临时文件
# ======================================
.DS_Store
Thumbs.db
desktop.ini

# ======================================
# 5. 其他临时文件
# ======================================
*.log
*.out
*.err
.ipynb_checkpoints/

# ======================================
# 6. 项目特定忽略项
# ======================================
# 本地分词器缓存（可从 HuggingFace 重新下载）
artifacts/tokenizer/

# 进度文件（运行中生成）
*.tmp
*.progress

# 失败样本记录
failed_samples.jsonl

